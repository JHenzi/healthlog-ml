# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local runtime state
/config/
/data/
.env
.env.*
!.env.example

# Health data: HAE exports and database dumps must never be committed
HealthAutoExport-*.json
*.json.zst
*.json.gz
*.dump
*.sql
# ...except the Companion's hand-written bootstrap script (not a dump).
!companion/bootstrap/*.sql
*.sql.gz
/backup.sh

# Exports from other tracking apps, and key lists extracted from them
/mobileappdata/
/extracted_keys.json
/extracted_nested_keys.json
/makekeys.py

# Editor backup files (may hold copies of secrets, e.g. .env~)
*~

# Editor / OS
.DS_Store
.idea/
.vscode/

# Private notes: local only, never pushed
/companion/docs/private/

# Local Claude Code permissions (may quote commands and paths)
/.claude/settings.local.json
