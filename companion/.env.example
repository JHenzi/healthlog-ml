# The fork's own settings: the Companion, Grafana and the locked-down network (compose.local.yml).
# HealthLog's settings are in the root `.env.example` (upstream's). Both go into ONE root `.env`, which
# docker compose reads:
#
#   cp .env.example .env && cat companion/.env.example >> .env
#
# Then fill in the required values below and in HealthLog's part (POSTGRES_PASSWORD, INGEST_SECRET).
# Never commit your `.env`.

# --- Required -------------------------------------------------------------

# Your IANA time zone. Required here: HealthLog's own default is Europe/Vienna, and the Companion refuses
# to start without it. It sets what a "day" is for both.
TZ=

# Password of the Companion's read-only database role (bootstrap.sql creates it).
# Generate one: openssl rand -hex 24
COMPANION_DB_PASSWORD=

# Grafana's admin password, and the password of its read-only database role `grafana_ro`
# (companion/bootstrap/grafana_ro.sql creates it).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_RO_PASSWORD=

# --- Optional (defaults shown) ---------------------------------------------

# Local time at which one day ends and the next begins, so late nights count as the evening before.
#DAY_BOUNDARY=04:00

# Where the web app is published. Keep it on localhost and put HTTPS in front (Tailscale Serve, nginx, Caddy).
#COMPANION_BIND=127.0.0.1
#COMPANION_PORT=8020

# Send the session cookie over HTTPS only. Leave on; sign-in needs HTTPS.
#COMPANION_COOKIE_SECURE=true

# Run HealthLog built from this checkout instead of upstream's image (companion/scripts/deploy.sh does this).
#HEALTHLOG_IMAGE=ghcr.io/anym001/healthlog

# Weather and air quality (opt-in). Your home area; the collector rounds it to ~10 km before anything is
# sent. WEATHER_SINCE: first day to backfill, e.g. your first HealthLog day (default: 92 days ago).
#WEATHER_LATITUDE=
#WEATHER_LONGITUDE=
#WEATHER_SINCE=

# Public holidays for the almanac: US, CA, GB, DE or none (default: picked from TZ).
#HOLIDAYS_COUNTRY=

# Phone reminders (opt-in). Make the key pair with:
#   docker exec healthlog-companion companion push keys
# The private key is a secret. VAPID_SUBJECT is a contact for the push services (mailto: or https:).
#PUSH_ENABLED=false
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=https://github.com/JHenzi/healthlog-ml
